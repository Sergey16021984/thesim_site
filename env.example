# 🔒 TheSim - Переменные окружения
# Скопируйте этот файл в .env и заполните своими значениями

# 🔐 Security Secrets (ОБЯЗАТЕЛЬНО ПОМЕНЯЙТЕ!)
JWT_SECRET=your_jwt_secret_here_min_32_chars
ENCRYPTION_KEY=your_encryption_key_32_chars_exactly
COOKIE_SECRET=your_cookie_secret_here_min_32_chars
CSRF_SECRET=your_csrf_secret_here_min_32_chars

# 🌍 Allowed Origins (разделенные запятыми)
ALLOWED_ORIGINS=http://localhost,https://localhost,https://yourdomain.com

# 📊 Database (если используется)
DATABASE_URL=postgresql://user:password@localhost:5432/thesim

# 🔔 Telegram Bot для уведомлений
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# 🌐 Google Translate API (если используется)
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

# 🏭 Production Settings
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
